generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model audit_logs {
  id         Int      @id @default(autoincrement())
  user_id    Int?
  username   String   @default("System") @db.VarChar(100)
  action     String   @db.VarChar(100)
  module     String   @db.VarChar(100)
  details    String
  ip_address String   @default("127.0.0.1") @db.VarChar(45)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  users      users?   @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([created_at(sort: Desc)], map: "idx_audit_logs_created_at")
  @@index([module], map: "idx_audit_logs_module")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model download_histories {
  id            Int      @id @default(autoincrement())
  user_id       Int?
  username      String   @db.VarChar(100)
  user_email    String   @db.VarChar(255)
  report_id     Int?
  report_title  String   @db.VarChar(255)
  filename      String   @db.VarChar(255)
  downloaded_at DateTime @default(now()) @db.Timestamptz(6)
  ip_address    String   @default("127.0.0.1") @db.VarChar(45)
  reports       reports? @relation(fields: [report_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users         users?   @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([report_id], map: "idx_download_histories_report_id")
  @@index([user_id], map: "idx_download_histories_user_id")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model email_logs {
  id                   Int      @id @default(autoincrement())
  subject              String   @db.VarChar(255)
  content              String
  recipient_group      String   @default("All Staff") @db.VarChar(100)
  recipients_count     Int      @default(0)
  status               String   @default("Sent") @db.VarChar(50)
  sent_at              DateTime @default(now()) @db.Timestamptz(6)
  created_by           String   @default("Admin") @db.VarChar(100)
  has_attachment       Boolean  @default(false)
  attached_report_name String?  @db.VarChar(255)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model login_histories {
  id             Int       @id @default(autoincrement())
  user_id        Int?
  username       String    @db.VarChar(100)
  login_at       DateTime  @default(now()) @db.Timestamptz(6)
  logout_at      DateTime? @db.Timestamptz(6)
  is_success     Boolean   @default(true)
  ip_address     String    @default("127.0.0.1") @db.VarChar(45)
  device_info    String    @default("Chrome / Windows")
  failure_reason String?
  users          users?    @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([user_id], map: "idx_login_histories_user_id")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model notifications {
  id            Int       @id @default(autoincrement())
  title         String    @db.VarChar(255)
  message       String
  category      String    @default("Report") @db.VarChar(50)
  priority      String    @default("Normal") @db.VarChar(50)
  is_archived   Boolean   @default(false)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  scheduled_for DateTime? @db.Timestamptz(6)
  created_by    String    @default("System") @db.VarChar(100)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model reports {
  id                 Int                  @id @default(autoincrement())
  title              String               @db.VarChar(255)
  filename           String               @unique @db.VarChar(255)
  original_name      String               @db.VarChar(255)
  file_size          BigInt               @default(0)
  category           String               @db.VarChar(100)
  location           String               @default("All") @db.VarChar(100)
  storage_path       String
  generated_by       String               @default("Stata / n8n System") @db.VarChar(100)
  status             String               @default("Approved") @db.VarChar(50)
  version            Int                  @default(1)
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  updated_at         DateTime             @default(now()) @db.Timestamptz(6)
  download_count     Int                  @default(0)
  download_histories download_histories[]

  @@index([category], map: "idx_reports_category")
  @@index([created_at(sort: Desc)], map: "idx_reports_created_at")
  @@index([location], map: "idx_reports_location")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model users {
  id                 Int                  @id @default(autoincrement())
  username           String               @unique @db.VarChar(100)
  email              String               @unique @db.VarChar(255)
  password_hash      String
  role               String               @default("Staff") @db.VarChar(50)
  department         String?              @default("General") @db.VarChar(100)
  is_active          Boolean              @default(true)
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  last_login_at      DateTime?            @db.Timestamptz(6)
  audit_logs         audit_logs[]
  download_histories download_histories[]
  login_histories    login_histories[]

  @@index([email], map: "idx_users_email")
}
